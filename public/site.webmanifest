{
    "name": "VKGRAM",
    "short_name": "VKGRAM",
    "lang": "ru",
    "id": "/k/",
    "start_url": "./",
    "scope": "./",
    "scope_extensions": [
        {
            "type": "origin",
            "origin": "https://t.me"
        },
        {
            "type": "origin",
            "origin": "https://telegram.me"
        }
    ],
    "description": "VKgram — неофициальный веб-клиент Telegram в оформлении ВКонтакте.",
    "icons": [
        {
            "src": "assets/img/vkgram-icon-36.png",
            "sizes": "36x36",
            "type": "image/png"
        },
        {
            "src": "assets/img/vkgram-icon-48.png",
            "sizes": "48x48",
            "type": "image/png"
        },
        {
            "src": "assets/img/vkgram-icon-72.png",
            "sizes": "72x72",
            "type": "image/png"
        },
        {
            "src": "assets/img/vkgram-icon-96.png",
            "sizes": "96x96",
            "type": "image/png"
        },
        {
            "src": "assets/img/vkgram-icon-144.png",
            "sizes": "144x144",
            "type": "image/png"
        },
        {
            "src": "assets/img/vkgram-icon-192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "assets/img/vkgram-icon-256.png",
            "sizes": "256x256",
            "type": "image/png"
        },
        {
            "src": "assets/img/vkgram-icon-384.png",
            "sizes": "384x384",
            "type": "image/png"
        },
        {
            "src": "assets/img/vkgram-icon-512.png",
            "sizes": "512x512",
            "type": "image/png"
        }
    ],
    "share_target": {
        "action": "./share/",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [{
                "name": "files",
                "accept": "*/*"
            }]
        }
    },
    "theme_color": "#597da3",
    "background_color": "#edeef0",
    "display": "standalone",
    "gcm_sender_id": "122867383838"
}
